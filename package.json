{
  "name": "naughtypilot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "preview": "node server.mjs --built",
    "vercel-build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:founder": "playwright test --config playwright.founder.config.ts",
    "typecheck": "tsc --noEmit",
    "test:release": "npm run typecheck && npm run build && npm test && npm run test:e2e && npm run test:e2e:founder"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "express": "^4.21.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
