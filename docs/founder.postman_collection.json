{
  "info": {
    "name": "Naughty Pilot founder public contract",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:4190" }],
  "item": [
    {
      "name": "Configured health and disabled spending",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('healthy Supabase API',()=>pm.response.to.have.status(200));",
              "pm.test('live spending disabled',()=>pm.expect(pm.response.json().real_spending_enabled).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unauthenticated identity",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/cockpit/auth/me" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('identity response is JSON',()=>pm.response.to.have.status(200));",
              "pm.test('founder only and no session',()=>{const d=pm.response.json();pm.expect(d.founder_only).to.eql(true);pm.expect(d.user).to.eql(null);});"
            ]
          }
        }
      ]
    },
    {
      "name": "State requires founder login",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/cockpit/state" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('state protected',()=>pm.response.to.have.status(401));",
              "pm.test('structured auth error',()=>pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Public registration disabled",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/cockpit/auth/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registration disabled',()=>pm.response.to.have.status(403));",
              "pm.test('no registration bypass',()=>pm.expect(pm.response.json().code).to.eql('REGISTRATION_DISABLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown API is JSON",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/unknown" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown API returns 404',()=>pm.response.to.have.status(404));",
              "pm.test('never SPA HTML',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]
          }
        }
      ]
    }
  ]
}
