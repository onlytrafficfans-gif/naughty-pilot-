{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": { "env": { "VITE_FOUNDER_MODE": "true" } },
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/go/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|go/).*)", "destination": "/index.html" }
  ]
}
